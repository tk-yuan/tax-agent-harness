# 复制为 .env 并填入自己的 key

# 检索用的向量与重排（硅基流动）
SILICONFLOW_API_KEY=sk-your-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Agent 的推理模型
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
HARNESS_MODEL=deepseek-chat

# 运行时约束（可选，不填用默认值）
# 一次完整筹划实测要 20~35 轮，40 是留了余量的值
HARNESS_MAX_TURNS=40
HARNESS_SUBAGENT_TURNS=8
HARNESS_CTX_BUDGET=60000
HARNESS_TOOL_INLINE=2000
